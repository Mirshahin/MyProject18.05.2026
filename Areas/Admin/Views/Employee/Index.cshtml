@using MyProject18._05._2026.Models
@model IEnumerable<Employee>

@{
    ViewData["Title"] = "Employee List";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Employee Management Panel</h2>
        <a asp-area="Admin" asp-controller="Employee" asp-action="Create" class="btn btn-success">
            <i class="fas fa-plus"></i> Add New Employee
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Surname</th>
                        <th>Age</th>
                        <th>Position</th>
                        <th>Assigned Range</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int count = 1;
                        foreach (var employee in Model)
                        {
                            <tr>
                                <td>@count</td>
                                <td>@employee.Name</td>
                                <td>@employee.Surname</td>
                                <td><span class="badge bg-secondary">@employee.Age</span></td>
                                <td>@employee.Position</td>
                                <td>
                                    @if (employee.Range != null)
                                    {
                                        <span class="badge bg-info text-dark">@employee.Range.name</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">No Range Assigned</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-area="Admin" asp-controller="Employee" asp-action="Edit" asp-route-id="@employee.Id" class="btn btn-sm btn-primary">
                                            Edit
                                        </a>

                                        <form asp-area="Admin" asp-controller="Employee" asp-action="Delete" asp-route-id="@employee.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this employee?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            count++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No active employees found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>